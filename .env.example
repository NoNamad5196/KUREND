# 처음 실행: 이 파일을 .env로 복사합니다. 기존 .env는 덮어쓰지 마세요.
# Git에는 이 예시만 올리고, 실제 API 키는 .env 또는 비밀값 설정에 보관합니다.

# C의 Prisma/SQLite 파일 DB. 프로젝트 루트 기준 상대경로 (pnpm db:reset 으로 생성·시드)
DATABASE_URL="file:./prisma/dev.db"
# 원격 libSQL(Turso 등)을 쓸 때: DATABASE_URL="libsql://<db>.turso.io" 와 함께 토큰을 넣습니다.
# DATABASE_AUTH_TOKEN=
# Render 시작 스크립트에서는 TURSO_DATABASE_URL / TURSO_AUTH_TOKEN 별칭도 지원합니다.
# 원격 DB 최초 준비는 scripts/render-db.mjs 사용(Prisma CLI db:push는 로컬 SQLite용).

# 기본값은 API 키 없이 실행 가능한 stub(데모 세이프 모드)입니다.
# 실제 모델: openai 또는 anthropic으로 바꾸고 해당 API 키 하나를 입력합니다.
LLM_PROVIDER=stub
# 비우면 provider 기본 모델을 씁니다 (src/lib/llm/README.md 참고).
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# main 에는 C 의 DB·인증 어댑터가 연결돼 있어 이 값은 무시됩니다(0 유지).
# 1은 C 없이 D 라우트만 단독 실행할 때 메모리 DB/데모 인증을 켭니다.
D_STUB_BACKEND=0
# stub 문장당 지연(ms). 빠른 자동 검증은 0으로 설정합니다.
LLM_STUB_DELAY_MS=300

# 실제 API는 /api. B의 독립 화면 개발에서는 /api/mock 사용 가능.
NEXT_PUBLIC_API_BASE=/api
SESSION_COOKIE=tb_uid
# Optional dedicated session-signing secret; otherwise the Google client secret is used.
# SESSION_SECRET=
