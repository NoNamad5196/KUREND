# 처음 실행: 이 파일을 .env로 복사합니다. 기존 .env는 덮어쓰지 마세요.
# Git에는 이 예시만 올리고, 실제 API 키는 .env 또는 비밀값 설정에 보관합니다.

# C의 Prisma/SQLite 연결용. D 단독 데모는 DB 파일을 사용하지 않습니다.
DATABASE_URL="file:./dev.db"

# 기본값은 API 키 없이 실행 가능한 D 데모입니다.
# 실제 모델: openai 또는 anthropic으로 바꾸고 해당 API 키 하나를 입력합니다.
LLM_PROVIDER=stub
# 비우면 openai: gpt-4.1-mini / anthropic: claude-sonnet-4-6
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 1은 stub 제공자와 함께 쓸 때만 임시 메모리 DB/데모 인증을 활성화합니다.
# 실제 HTTP 서비스는 0으로 바꾸고 C의 DB·인증 어댑터를 연결해야 합니다.
D_STUB_BACKEND=1
# 문장당 데모 지연(ms). 빠른 자동 검증은 0으로 설정합니다.
LLM_STUB_DELAY_MS=300

# D의 실제 라우트는 /api. B의 독립 화면 개발에서는 /api/mock 사용 가능.
NEXT_PUBLIC_API_BASE=/api
SESSION_COOKIE=tb_uid
